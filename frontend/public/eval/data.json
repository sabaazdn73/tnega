    "title": "Design basis",
    "owner": "human_signs",
    "gate": true,
    "ai": "Finds the legal source, the adopted editions and the state amendments, and flags conflicts.",
    "human": "Opens the official sources, reads the amendments clause by clause for every provision the task uses, and signs the basis sheet.",
    "output": "Signed basis-of-design sheet."
   },
   {
    "id": "s3",
    "n": 3,
    "title": "Trap design and private solution",
    "owner": "ai_check",
    "gate": false,
    "ai": "Solves the task by script and tests the answer under every defensible assumption (margins of at least 1.3).",
    "human": "Approves the branch: is the correct answer the one an expert would sign?",
    "output": "Solution script and a robustness table."
   },
   {
    "id": "s4",
    "n": 4,
    "title": "Cheap difficulty test",
    "owner": "ai_check",
    "gate": false,
    "ai": "Runs blind solvers on the prompt and a text version of the files, before any polished file is built.",
    "human": "Judges each failure: serious and valid, or caused by ambiguity.",
    "output": "Table of blind runs: which model caught which item."
   },
   {
    "id": "s5",
    "n": 5,
    "title": "Input files and audit",
    "owner": "ai_check",
    "gate": false,
    "ai": "Builds the drawings, calculations and letters from real reference sets, and audits them for leaks and consistency.",
    "human": "Rules on each audit flag: fix it, or keep it as an intended trap.",
    "output": "Final input package and a decision on every flag."
   },
   {
    "id": "s6",
    "n": 6,
    "title": "Prompt and final runs",
    "owner": "ai_check",
    "gate": false,
    "ai": "Drafts the prompt and runs the target models.",
    "human": "Writes or approves the prompt in their own words and confirms each failure is serious and not caused by the files.",
    "output": "A failure description for each run, with values and file references."
   },
   {
    "id": "s7",
    "n": 7,
    "title": "Golden solution",
    "owner": "ai_check",
    "gate": false,
    "ai": "Writes the expected-answer description before solving, then scripts the golden solution so inputs, outputs and deliverables reproduce from one another.",
    "human": "Checks the assumptions and the numbers that decide the result.",
    "output": "Simulation inputs, outputs and deliverables."
   },
   {
    "id": "s8",
    "n": 8,
    "title": "Criteria or answer key",
    "owner": "ai_check",
    "gate": false,
    "ai": "Drafts the key or the deterministic checks, with tolerances and a negative criterion for each serious error.",
    "human": "Spot-checks the decisive numbers and ranges.",
    "output": "Answer key or checks, and grader tests: the golden solution scores 100 % and every lure fails."
