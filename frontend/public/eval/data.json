   {
    "id": "s7",
    "n": 7,
    "title": "Golden solution",
    "owner": "ai_check",
    "gate": false,
    "ai": "Writes the expected-answer description before solving, then scripts the golden solution so inputs, outputs and deliverables reproduce from one another.",
    "human": "Checks the assumptions and the numbers that decide the result.",
    "output": "Simulation inputs, outputs and deliverables."
   },
   {
    "id": "s8",
    "n": 8,
    "title": "Criteria or answer key",
    "owner": "ai_check",
    "gate": false,
    "ai": "Drafts the key or the deterministic checks, with tolerances and a negative criterion for each serious error.",
    "human": "Spot-checks the decisive numbers and ranges.",
